DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=change-me

ARK_API_KEY=change-me
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=change-me

EMBEDDING_PROVIDER=volcengine_ark
EMBEDDING_MODEL_NAME=ep-20260703164659-v5sh5
# Optional: configure only when embedding credentials differ from ARK_*.
# EMBEDDING_API_KEY=change-me
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

DATABASE_URL=sqlite:///./data/script_agent.db
SEARCH_INDEX_BACKEND=sqlite
SEARCH_INDEX_DB_PATH=./data/search_index.db
SEARCH_INDEX_PATH=./data/search_index.json
CHROMA_PERSIST_DIR=./data/chroma_db

# Passwordless trusted-intranet deployment. Every client that can reach the
# service has full application access; restrict the port at the network layer.
FACAI_AI_RATE_LIMIT_PER_MINUTE=30
FACAI_UPLOAD_RATE_LIMIT_PER_MINUTE=20
FACAI_REBUILD_RATE_LIMIT_PER_HOUR=4
FACAI_AI_DAILY_TOKEN_BUDGET=500000
FACAI_AI_USAGE_RETENTION_DAYS=90
FACAI_RAG_LOG_RETENTION_DAYS=30
FACAI_AUDIT_RETENTION_DAYS=180
FACAI_TASK_RETENTION_DAYS=30

# SQLite backup/restore verification. Point OFFSITE_DIR to a separately managed
# disk or UNC share; leaving it blank keeps only the bounded local copy.
FACAI_DAILY_BACKUP_ENABLED=1
FACAI_BACKUP_RETENTION_DAYS=30
FACAI_BACKUP_MAX_DAILY=30
FACAI_BACKUP_MAX_MIGRATION=10
FACAI_BACKUP_OFFSITE_DIR=

# Readiness thresholds. Dependency failures affect /readyz, never /healthz.
FACAI_SEARCH_INDEX_MAX_AGE_HOURS=72
FACAI_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
FACAI_MIN_FREE_DISK_BYTES=2147483648
FACAI_MIN_FREE_DISK_PERCENT=5

AI_BASE_URL_ALLOWLIST=api.deepseek.com,dashscope.aliyuncs.com,api.minimax.io,open.bigmodel.cn

# Ecommerce API integration center (required only when this feature is configured)
FACAI_INTEGRATIONS_MASTER_KEY=
FACAI_INTEGRATIONS_INTERNAL_BASE_URL=
FACAI_INTEGRATIONS_PUBLIC_BASE_URL=
FACAI_INTEGRATION_ARCHIVE_DIR=
FACAI_INTEGRATIONS_TRUSTED_PROXY_CIDRS=
FACAI_DESTRUCTIVE_TEST_DATABASE_ACK=
FACAI_INTEGRATION_WORKER_ENABLED=0
FACAI_INTEGRATION_WORKER_CONCURRENCY=4

# Product Canvas local file storage and provider credentials. Keep third-party
# API keys only in the local .env file.
CANVAS_DATA_DIR=data/canvas_projects
CANVAS_MAX_UPLOAD_BYTES=12582912
CANVAS_MAX_IMAGE_EDGE=16384
CANVAS_MAX_IMAGE_PIXELS=40000000
CANVAS_PREVIEW_MAX_EDGE=2048
CANVAS_PROJECT_QUOTA_BYTES=5368709120
CANVAS_TOTAL_QUOTA_BYTES=21474836480
CANVAS_MIN_FREE_BYTES=2147483648
CANVAS_REMBG_MODEL_DIR=data/models/rembg
CANVAS_REMBG_WORKERS=1
CANVAS_LOCAL_OPERATION_WORKERS=1
CANVAS_REMOTE_IMAGE_MAX_BYTES=26214400
CANVAS_PROVIDER_SECRET_KEY=
CANVAS_PROVIDER_ALLOWED_HOSTS=ark.cn-beijing.volces.com
CANVAS_PROVIDER_PRIVATE_ALLOWED_HOSTS=
CANVAS_PROVIDER_PRIVATE_ALLOWED_IPS=
CANVAS_ALLOW_INSECURE_PROVIDER_HTTP=0
CANVAS_PROVIDER_CONNECT_TIMEOUT_SECONDS=10
CANVAS_PROVIDER_TOTAL_TIMEOUT_SECONDS=60
CANVAS_PROVIDER_MAX_JSON_BYTES=1048576
CANVAS_GENERATION_CONCURRENCY=1
CANVAS_GENERATION_LEASE_SECONDS=60
